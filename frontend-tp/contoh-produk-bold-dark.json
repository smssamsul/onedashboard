        { "nama": "", "content": "<p>Sudah keluar budget iklan, tapi hasil leads &amp; closing belum maksimal.</p>", "icon": "AlertCircle", "iconColor": "#ef4444" },
        { "nama": "", "content": "<p>Konten sering tidak konsisten karena proses produksi terlalu ribet &amp; manual.</p>", "icon": "AlertCircle", "iconColor": "#ef4444" },
        { "nama": "", "content": "<p>Leads masuk, tapi tidak terukur dan sulit dianalisa &mdash; tidak tahu apa yang harus dioptimasi.</p>", "icon": "AlertCircle", "iconColor": "#ef4444" },
