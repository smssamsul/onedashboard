        { "nama": "", "content": "<p><strong>Desain eksklusif</strong> &mdash; motif khas Ternak Properti, tidak pasaran, cocok jadi identitas komunitas.</p>", "icon": "CheckCircle2", "iconColor": "#22c55e" },
        { "nama": "", "content": "<p><strong>Jahitan rapi</strong> &mdash; rib pada kerah dan lengan tidak mudah melar walau sering dicuci.</p>", "icon": "CheckCircle2", "iconColor": "#22c55e" },
        { "nama": "", "content": "<p><strong>Ukuran lengkap</strong> &mdash; tersedia dari size S sampai XXL, cek panduan ukuran sebelum order.</p>", "icon": "CheckCircle2", "iconColor": "#22c55e" },
        { "nama": "", "content": "<p><strong>Fleksibel dipakai</strong> &mdash; cocok untuk santai, gathering komunitas, sampai jadi seragam tim survey.</p>", "icon": "CheckCircle2", "iconColor": "#22c55e" }
      ]
    }
