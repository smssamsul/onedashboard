        { "nama": "", "content": "<p><strong>Bahan premium</strong> &mdash; Cotton Combed 30s yang adem, menyerap keringat, dan tidak mudah luntur.</p>", "icon": "CheckCircle2", "iconColor": "#22c55e" },
